    "definitions": {
        "internal_transport_http_handler.AuthResp": {
            "type": "object",
            "properties": {
                "role": {
                    "type": "string",
                    "example": "user"
                },
                "user_id": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "internal_transport_http_handler.ConfirmOTPByPhoneReq": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 1234
                },
                "phone": {
                    "type": "string",
                    "example": "+380501234567"
                }
            }
        },
        "internal_transport_http_handler.CreateUserReq": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "email@example.com"
                },
                "last_name": {
                    "type": "string",
                    "example": "lastName"
                },
                "login": {
                    "type": "string",
                    "example": "login"
                },
                "name": {
                    "type": "string",
                    "example": "name"
                },
                "password": {
                    "type": "string",
                    "example": "password"
                }
            }
        },
        "internal_transport_http_handler.CreateUserResp": {
