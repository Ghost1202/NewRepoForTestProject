{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/users/auth": {
            "post": {
                "description": "Validates identifier/password and returns JWT access token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Authorization by login/email (get JWT)",
                "parameters": [
                    {
                        "description": "Credentials",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http_handler.LoginReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http_handler.LoginResp"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/users/auth/phone": {
            "post": {
                "description": "Validates phone/password and returns JWT access token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Authorization by phone (get JWT)",
                "parameters": [
                    {
                        "description": "Phone credentials",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http_handler.LoginByPhoneReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http_handler.LoginResp"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/users/google/callback": {
            "get": {
                "description": "Handles Google OAuth callback and returns JWT access token.\nIf FRONTEND_URL is set, sets HttpOnly cookie \"auth_token\" and redirects to FRONTEND_URL/auth/callback.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Google OAuth callback (get JWT)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Google auth code",
                        "name": "code",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "JSON response when FRONTEND_URL is empty",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http_handler.LoginResp"
                        }
                    },
                    "302": {
                        "description": "Redirect to frontend callback when FRONTEND_URL is set",
                        "schema": {
                            "type": "string"
                        },
                        "headers": {
                            "Set-Cookie": {
                                "type": "string",
                                "description": "auth_token=\u003cJWT\u003e; HttpOnly"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/users/google/login": {
            "get": {
                "description": "Redirects user to Google OAuth consent screen",
                "tags": [
                    "users"
                ],
                "summary": "Google Login Redirect",
                "responses": {
                    "307": {
                        "description": "Redirect to Google",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/users/login": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Protected endpoint. Returns user data extracted from the Bearer token.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "JWT verification / user info",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http_handler.AuthResp"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/users/otp/phone/confirm": {
            "post": {
                "description": "Confirms OTP and returns JWT access token.",
