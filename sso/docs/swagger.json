                },
                "phone": {
                    "type": "string",
                    "example": "+380501234567"
                }
            }
        },
        "internal_transport_http_handler.LoginReq": {
            "type": "object",
            "properties": {
                "identifier": {
                    "type": "string",
                    "example": "email@example.com"
                },
                "is_email": {
                    "type": "boolean",
                    "example": true
                },
                "password": {
                    "type": "string",
                    "example": "password"
                }
            }
        },
        "internal_transport_http_handler.LoginResp": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                },
                "login": {
                    "type": "string",
                    "example": "login"
                },
                "role": {
                    "type": "string",
                    "example": "user"
                },
                "user_id": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "internal_transport_http_handler.ResetEmailConfirmReq": {
            "type": "object",
