# Build
GITHUB_TOKEN=
GITHUB_PAT_TOKEN=
GOPRIVATE=github.com/turtlepavlo/*

# Database
DB_HOST=sso-db-test
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=sso_test
DB_SSLMODE=disable

# Auth
JWT_SECRET=change-me
JWT_TTL=24h

# Kafka
ANALYTICS_KAFKA_HOST=kafka
ANALYTICS_KAFKA_PORT=29092
ANALYTICS_KAFKA_TOPIC=analytics_events
ALLOW_AUTO_TOPIC_CREATION=true

# Logging
LOG_MODE=development
LOG_LEVEL=debug
LOG_ENCODING=json
LOG_OUTPUT=stdout
LOG_ERROR_OUTPUT=stderr
LOG_OTLP_ENABLED=true
LOG_OTLP_ENDPOINT=otel-collector:4317
LOG_OTLP_INSECURE=true
LOG_OTLP_SCOPE=

# OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=sso
OTEL_ENVIRONMENT=test
OTEL_SERVICE_VERSION=1.0.0
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=test,service.namespace=sso
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Published ports
HTTP_PORT_HOST=8080
GRPC_PORT_HOST=9090
