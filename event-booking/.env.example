# Database replica
DB_REPLICA_HOST=event-db-replica
DB_REPLICA_PORT=5432
DB_USER=event_service
DB_PASSWORD=event_pass_secure
DB_NAME=event_db
DB_SSLMODE=disable

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=3434

# Auth
JWT_SECRET=change-me

# Booking
BOOKING_TICKET_LOCK_TTL=10m

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=event-booking-service

# Redis
HOST_REDIS=booking_redis
PORT_REDIS=6379

# Kafka
TRANSFER_KAFKA_HOST=kafka
TRANSFER_KAFKA_PORT=29092
TRANSFER_KAFKA_TOPIC=ticket_transfer_requested
TRANSFER_KAFKA_AUTO_CREATE_TOPIC=false
TRANSFER_KAFKA_REQUIRED_ACKS=1
TRANSFER_KAFKA_MAX_RETRIES=3
TRANSFER_KAFKA_WRITE_TIMEOUT=10s
TRANSFER_KAFKA_BATCH_SIZE=100
TRANSFER_KAFKA_BATCH_TIMEOUT=1s
